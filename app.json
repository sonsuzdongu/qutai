{
  "expo": {
    "name": "Qutai",
    "slug": "qutai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      },
      "buildNumber": "1",
      "bundleIdentifier": "com.sonsuzdongu.qutai"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "http"
            },
            {
              "scheme": "https"
            }
          ]
        }
      ],
      "versionCode": 1,
      "package": "com.sonsuzdongu.qutai",
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Qutai adds the screenshots you choose to save to your photos.",
          "granularPermissions": []
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "tr"
            ],
            "android": [
              "en",
              "tr"
            ]
          }
        }
      ],
      "expo-sqlite",
      "expo-mail-composer",
      [
        "expo-camera",
        {
          "cameraPermission": "Qutai uses the camera to scan QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Qutai uses Face ID to unlock the app and incognito tabs."
        }
      ],
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "calendarPermission": "Qutai adds events you confirm, such as tickets and reservations, to your calendar.",
          "writeOnlyCalendarPermission": "Qutai adds events you confirm, such as tickets and reservations, to your calendar.",
          "remindersPermission": "Qutai adds reminders you confirm to your Reminders."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Qutai shows your position to the sites you allow, such as maps, and to the assistant when you ask it to use your location.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-font"
    ],
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json"
    },
    "scheme": "qutai"
  }
}
