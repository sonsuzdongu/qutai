  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:account": "node --no-warnings --experimental-transform-types --import ./scripts/account-tests/resolve-ts.mjs --test scripts/account-tests/session.test.ts scripts/account-tests/email.test.ts scripts/account-tests/methods.test.ts",
    "test:account:server": "QUTAI_TEST_API_URL=${QUTAI_TEST_API_URL:-http://localhost:8790} node --no-warnings --experimental-transform-types --import ./scripts/account-tests/resolve-ts.mjs --test scripts/account-tests/server.test.ts",
    "test:cost": "node --no-warnings --experimental-transform-types --import ./scripts/account-tests/resolve-ts.mjs --test scripts/cost-tests/cost.test.ts scripts/cost-tests/fit.test.ts",
    "test:custom": "node --no-warnings --experimental-transform-types --import ./scripts/credits-tests/loader.mjs --test scripts/custom-endpoint-tests/*.test.ts",
    "test:instructions": "node --no-warnings --experimental-transform-types --import ./scripts/account-tests/resolve-ts.mjs --test scripts/instructions-tests/*.test.ts",
    "test:approvals": "TZ=Europe/Istanbul node --no-warnings --experimental-transform-types --import ./scripts/credits-tests/loader.mjs --test scripts/approval-tests/*.test.ts",
    "test:text": "node --no-warnings --experimental-transform-types --import ./scripts/credits-tests/loader.mjs --test scripts/text-tests/*.test.ts",
    "test:assistant": "node --no-warnings --experimental-transform-types --import ./scripts/credits-tests/loader.mjs --test scripts/assistant-tests/*.test.ts",
    "test:i18n": "node --no-warnings --experimental-transform-types --import ./scripts/credits-tests/loader.mjs --test scripts/i18n-tests/*.test.ts",
    "test:install": "node --no-warnings --experimental-transform-types --import ./scripts/account-tests/resolve-ts.mjs --test scripts/install-tests/*.test.ts",
    "test:layout": "node --no-warnings --experimental-transform-types --import ./scripts/account-tests/resolve-ts.mjs --test scripts/layout-tests/*.test.ts",
    "test:siterules": "node --no-warnings --experimental-transform-types --import ./scripts/account-tests/resolve-ts.mjs --test scripts/site-rules-tests/*.test.ts",
    "test:credits": "node --no-warnings --experimental-transform-types --import ./scripts/credits-tests/loader.mjs --test scripts/credits-tests/*.test.ts",
    "test:backup": "node --no-warnings --experimental-transform-types --import ./scripts/account-tests/resolve-ts.mjs --test scripts/backup-tests/logic.test.ts scripts/backup-tests/client.test.ts",
    "test:backup:server": "QUTAI_TEST_API_URL=${QUTAI_TEST_API_URL:-http://localhost:8790} node --no-warnings --experimental-transform-types --import ./scripts/account-tests/resolve-ts.mjs --test scripts/backup-tests/server.test.ts",
    "measure:tokens": "node --no-warnings --experimental-transform-types --import ./scripts/credits-tests/loader.mjs scripts/token-tests/measure.ts",
    "measure:backup": "node --no-warnings --experimental-transform-types --import ./scripts/account-tests/resolve-ts.mjs scripts/backup-tests/measure.ts",
    "test:credits:server": "QUTAI_TEST_API_URL=${QUTAI_TEST_API_URL:-http://localhost:8790} node --no-warnings --experimental-transform-types --import ./scripts/credits-tests/loader.mjs --test scripts/credits-tests/server/relay-server.test.ts",
    "profile:export": "node --no-warnings --experimental-transform-types --import ./scripts/account-tests/resolve-ts.mjs scripts/agent-profile/export.ts",
    "profile:check": "node --no-warnings --experimental-transform-types --import ./scripts/account-tests/resolve-ts.mjs scripts/agent-profile/export.ts --check",
