# Copy to .env (git-ignored) and adjust. EXPO_PUBLIC_ values are built into the app and are
# readable by anyone who has it: never put API keys, passwords or other secrets here.
# Values are read when the app is bundled (restart with `npx expo start -c` after a change); the pro-mode
# native setup (Sign in with Apple entitlement, Google URL scheme) is read by `npx expo prebuild` / `expo run:*`.

# off (default): the open-source app. Users bring their own Anthropic / OpenAI / Gemini key and
# everything stays on the device. on: also the features that use Qutai's servers (accounts,
# sync, Qutai credits); this is how the official App Store and Google Play builds are made.
EXPO_PUBLIC_PRO_MODE=off

# Qutai's API address, used only when EXPO_PUBLIC_PRO_MODE=on; accounts and Qutai Credits (the AI provider paid
# with the account's credits, README.md › Qutai Credits) appear only when both are set.
# Point it at your own server if you run one. The server in backend/ runs locally on port 8790
# (`cd backend && npm run dev`):
#   Android emulator:      http://10.0.2.2:8790
#   iOS simulator:         http://localhost:8790
#   a phone on your Wi-Fi: http://<your computer's LAN address>:8790 (e.g. http://192.168.1.20:8790)
EXPO_PUBLIC_QUTAI_API_URL=

# Sign in with Google (pro mode). OAuth client ids from the Google Cloud console (not secrets, but keep the real
# ones out of the repository). The web client id is the "server client id" Android asks Google for (it is the
# ID token's audience the server checks); the iOS client id is used on iOS. Empty: no Google button on that
# platform. Both look like 1234567890-abc123.apps.googleusercontent.com.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Test sign-in (pro mode, LOCAL TEST SERVERS ONLY): on adds a "Test sign-in" under the Apple and Google buttons in
# Settings › Account that signs in as one of the server's test users (test-1 to test-3) through POST /auth/dev,
# which a server has only when its own uncommitted .dev.vars switches it on (backend/README.md › Test sign-in).
# The secret must be the server's DEV_SIGN_IN_SECRET (`node scripts/generate-secret.mjs dev-sign-in` in backend/).
# WARNING: EXPO_PUBLIC_ values are built into the app and readable by anyone who has it, the secret included.
# A build with this on is for your own local test server only: never share it, upload it or ship it, and make a
# new server secret if such a build leaves your hands. Off (or no secret): no test sign-in, and the secret isn't
# read into the app. Keep it off for every other build; eas.json never sets it.
EXPO_PUBLIC_DEV_LOGIN=off
EXPO_PUBLIC_DEV_LOGIN_SECRET=

# Qutai Credits end to end on a phone (README.md › Qutai Credits › Trying it end to end): the four values above for
# the test sign-in (PRO_MODE on, the server's tunnel address, DEV_LOGIN on and its secret) are all it needs; credits
# have no variable of their own. The server needs seed:local, the agent profile registered, your own provider keys in
# backend/apps/api/.dev.vars, and credits granted to the test user in the admin panel.
