+RCT_EXPORT_METHOD(removeContentRuleLists:(NSString *)prefix keep:(NSString *)keep resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject)
+{
+    WKContentRuleListStore *store = [WKContentRuleListStore defaultStore];
+    NSSet<NSString *> *kept = [NSSet setWithArray:[keep componentsSeparatedByString:@"\n"]];
