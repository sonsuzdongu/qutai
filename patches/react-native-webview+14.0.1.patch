+package com.reactnativecommunity.webview;
+
+import android.os.Handler;
+import android.os.Looper;
+import android.os.Message;
+import android.webkit.WebView;
+
+import androidx.annotation.Nullable;
+import androidx.annotation.UiThread;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Qutai patch: windows a page opens (window.open, target=_blank) as real pop-ups that keep their opener.
+ *
+ * The WebView asks for a new window with onCreateWindow and waits for the app to send back the WebView that hosts it
+ * (WebViewTransport). The app's new tab is a React view created later, so the request waits here under an id: the
+ * opener's onOpenWindow event carries the id, the app opens a tab whose WebView has the popupId prop, and that WebView
+ * takes the request before it loads anything ({@link #claim}). The page in it then has window.opener (unless the page
+ * asked for noopener, which the engine honours) and may post its result back and close itself (onCloseWindow).
+ * A request nobody takes within {@link #TIMEOUT_MS}, or that the app refuses ({@link #release}), is dropped: the
+ * window never opens.
+ *
+ * All methods run on the UI thread.
+ */
+public final class RNCWebViewPopups {
+    static final long TIMEOUT_MS = 30_000;
+
+    private static final Map<String, Message> sPending = new HashMap<>();
+    private static final Handler sMain = new Handler(Looper.getMainLooper());
+    private static int sCounter = 0;
+
+    private RNCWebViewPopups() {}
+
+    /** Keeps the WebView's new-window request; returns its id for the app. */
+    @UiThread
+    public static String hold(Message resultMsg) {
+        final String id = "a" + (++sCounter);
+        sPending.put(id, resultMsg);
+        sMain.postDelayed(() -> sPending.remove(id), TIMEOUT_MS);
+        return id;
+    }
+
+    /**
+     * Hands the waiting request to this WebView, which must not have loaded anything yet. Returns false when there is
+     * no such request (taken, refused or timed out): the WebView then loads its source as usual.
+     */
+    @UiThread
+    public static boolean claim(@Nullable String id, WebView view) {
+        if (id == null || id.isEmpty()) return false;
+        Message msg = sPending.remove(id);
+        if (msg == null) return false;
+        if (view.copyBackForwardList().getSize() > 0) return false;
+        try {
+            WebView.WebViewTransport transport = (WebView.WebViewTransport) msg.obj;
+            transport.setWebView(view);
+            msg.sendToTarget();
+            return true;
+        } catch (RuntimeException e) {
+            return false;
+        }
+    }
+
+    /** The app refused the window (an ad, say): it never opens. */
+    @UiThread
+    public static void release(@Nullable String id) {
+        if (id != null) sPending.remove(id);
+    }
