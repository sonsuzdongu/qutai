--- /dev/null
+++ b/node_modules/react-native-webview/android/src/main/java/com/reactnativecommunity/webview/RNCWebViewProfiles.java
@@ -0,0 +1,172 @@
+package com.reactnativecommunity.webview;
+
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Log;
+import android.webkit.CookieManager;
+import android.webkit.WebView;
+
+import androidx.annotation.Nullable;
+import androidx.annotation.UiThread;
+import androidx.webkit.Profile;
+import androidx.webkit.ProfileStore;
+import androidx.webkit.WebViewCompat;
+import androidx.webkit.WebViewFeature;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Qutai patch: WebView profiles (androidx.webkit multi-profile API) for the webviewProfile prop.
+ *
+ * A profile has its own cookies, web storage (localStorage, IndexedDB, ...), HTTP cache, service workers and
+ * geolocation permissions. WebView never unloads a profile once a WebView of this process has used it, and
+ * ProfileStore.deleteProfile throws for a loaded profile, so a profile used in this process can only be emptied
+ * now (cookies, storage, geolocation permissions) and deleted at the next start, before anything loads it again.
+ * Callers therefore use a new profile name for each session and call {@link #end} when it is over.
+ *
+ * All methods run on the UI thread (WebView's own rule for these APIs).
+ */
+public final class RNCWebViewProfiles {
+    private static final String TAG = "RNCWebViewProfiles";
+
+    /** Live (not yet destroyed) WebViews per profile name. */
+    private static final Map<String, Integer> sLive = new HashMap<>();
+    /** Profiles whose session is over, emptied as soon as their last WebView is destroyed. */
+    private static final Set<String> sEnded = new HashSet<>();
+    private static final Handler sMain = new Handler(Looper.getMainLooper());
+
+    private RNCWebViewProfiles() {}
+
+    public static boolean isSupported() {
+        try {
+            return WebViewFeature.isFeatureSupported(WebViewFeature.MULTI_PROFILE);
+        } catch (Throwable e) {
+            // No WebView provider installed, or one that fails to load.
+            return false;
+        }
+    }
+
+    /**
+     * Puts a new WebView in the named profile (created if needed). Must happen before the WebView loads anything or
+     * runs JavaScript; the manager loads the source only after all props are set, so the prop setter is early enough.
+     * Settings, JavaScript interfaces and document-start scripts set before survive the switch.
+     * Null or "" keeps the default profile. A WebView's profile can't change later.
+     */
+    @UiThread
+    public static void apply(RNCWebView view, @Nullable String name) {
+        if (name == null || name.isEmpty()) return;
+        if (name.equals(view.profileName)) return;
+        if (view.profileName != null) {
+            Log.w(TAG, "A WebView's profile can't change after it is set");
+            return;
+        }
+        if (!isSupported()) return;
+        try {
+            WebViewCompat.setProfile(view, name);
+        } catch (IllegalStateException e) {
+            Log.e(TAG, "Could not set the WebView profile", e);
+            return;
+        }
+        view.profileName = name;
+        sEnded.remove(name);
+        Integer count = sLive.get(name);
+        sLive.put(name, count == null ? 1 : count + 1);
+    }
+
+    /** The WebView was destroyed: when its profile's session is over and no WebView uses it, it is emptied. */
+    @UiThread
+    public static void release(RNCWebView view) {
+        String name = view.profileName;
+        if (name == null || view.profileReleased) return;
+        view.profileReleased = true;
+        Integer count = sLive.get(name);
+        if (count == null || count <= 1) {
+            sLive.remove(name);
+            // After the current message: WebView.destroy() may finish tearing down the page asynchronously.
+            if (sEnded.contains(name)) sMain.post(() -> emptyIfUnused(name));
+        } else {
+            sLive.put(name, count - 1);
+        }
+    }
+
+    /**
+     * The session using this profile is over (JS has closed its tabs). Its data is removed now if no WebView uses
+     * it, otherwise when the last one is destroyed. The profile itself goes at the next start ({@link #deleteUnused}).
+     */
+    @UiThread
+    public static void end(String name) {
+        if (!isSupported()) return;
+        sEnded.add(name);
+        if (!sLive.containsKey(name)) emptyIfUnused(name);
+    }
+
+    /**
+     * Deletes every profile whose name starts with prefix and that no WebView of this process has loaded (left over
+     * from an earlier run, e.g. when the app was killed). Profiles in use or used earlier in this run are skipped
+     * (WebView can't delete them now); the latter were emptied when their session ended.
+     */
+    @UiThread
+    public static void deleteUnused(String prefix) {
+        if (prefix.isEmpty() || !isSupported()) return;
+        ProfileStore store = ProfileStore.getInstance();
+        for (String name : store.getAllProfileNames()) {
+            if (!name.startsWith(prefix) || sLive.containsKey(name)) continue;
+            try {
+                store.deleteProfile(name);
+            } catch (IllegalStateException | IllegalArgumentException e) {
+                // Loaded in this process (emptied when its session ended), or the default profile.
+            }
+        }
+    }
+
+    @UiThread
+    private static void emptyIfUnused(String name) {
+        if (sLive.containsKey(name) || !sEnded.remove(name)) return;
+        ProfileStore store = ProfileStore.getInstance();
+        try {
+            // Never loaded in this process (e.g. the session ended before any of its pages was shown).
+            store.deleteProfile(name);
+            return;
+        } catch (IllegalStateException loaded) {
+            // Used in this process: empty it; it is deleted at the next start.
+        }
+        Profile profile = store.getProfile(name);
+        if (profile == null) return;
+        try {
+            CookieManager cookies = profile.getCookieManager();
+            cookies.removeAllCookies(null);
+            cookies.flush();
+            profile.getWebStorage().deleteAllData();
+            profile.getGeolocationPermissions().clearAll();
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Could not empty WebView profile", e);
+        }
+    }
+
+    /**
+     * The cookie manager of a profile by name (null or "": the default profile), for Qutai's own downloads, which
+     * send a tab's cookies without a WebView at hand. Null when the profile doesn't exist (any more).
+     */
+    @UiThread
+    public static @Nullable CookieManager cookieManagerForProfile(@Nullable String name) {
+        if (name == null || name.isEmpty()) return CookieManager.getInstance();
+        if (!isSupported()) return null;
+        Profile profile = ProfileStore.getInstance().getProfile(name);
+        return profile != null ? profile.getCookieManager() : null;
+    }
+
+    /**
+     * The cookie store of this WebView's profile (the default one for WebViews without a profile), or null when its
+     * profile can't be found: never another profile's cookies.
+     */
+    @UiThread
+    public static @Nullable CookieManager cookieManagerFor(@Nullable WebView webView) {
+        String name = webView instanceof RNCWebView ? ((RNCWebView) webView).profileName : null;
+        if (name == null) return CookieManager.getInstance();
+        Profile profile = ProfileStore.getInstance().getProfile(name);
+        return profile != null ? profile.getCookieManager() : null;
+    }
+}
