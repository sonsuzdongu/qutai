@@ -0,0 +1,74 @@
+package com.reactnativecommunity.webview;
+
+import android.graphics.Rect;
+import android.view.View;
+import android.view.ViewTreeObserver;
+import android.view.WindowInsets;
+
+import androidx.annotation.NonNull;
+import androidx.core.graphics.Insets;
+import androidx.core.view.WindowInsetsCompat;
+
+/**
+ * Qutai patch: the safe-area insets a page gets (CSS env(safe-area-inset-*)) are only the parts of the system bars
+ * and display cutout that really cover the WebView.
+ *
+ * The app is edge to edge and keeps its views clear of the bars with padding in its React Native layout, so the
+ * window's insets reach the WebView untouched. Since M144 Android's WebView hands systemBars() and displayCutout()
+ * to pages with viewport-fit=cover in every WebView, and a WebView above the app's bottom address bar was given the
+ * navigation bar's height: YouTube and Instagram padded their bottom navigation by it, leaving an empty band above
+ * the address bar. Each side of those insets is reduced by the WebView's distance from that edge of the window
+ * (Android's own advice: zero the insets the app has already handled before they reach the WebView). The insets are
+ * applied again whenever the WebView moves or changes size (the address bar moved to the top, landscape).
+ */
+final class RNCWebViewInsets {
+    private static final int TYPES = WindowInsetsCompat.Type.systemBars() | WindowInsetsCompat.Type.displayCutout()
+            | WindowInsetsCompat.Type.tappableElement() | WindowInsetsCompat.Type.mandatorySystemGestures()
+            | WindowInsetsCompat.Type.systemGestures();
+
+    private RNCWebViewInsets() {}
+
+    /** The part of an inset of `inset` px at one edge that covers a view `distance` px away from that edge. */
+    static int covering(int inset, int distance) {
+        return Math.max(0, inset - Math.max(0, distance));
+    }
+
+    /** The insets that cover the view: each side reduced by the view's distance from that edge of the window. */
+    static WindowInsets clip(@NonNull View view, @NonNull WindowInsets insets) {
+        View root = view.getRootView();
+        int[] at = new int[2];
+        view.getLocationInWindow(at);
+        int left = at[0];
+        int top = at[1];
+        int right = root.getWidth() - (at[0] + view.getWidth());
+        int bottom = root.getHeight() - (at[1] + view.getHeight());
+        WindowInsetsCompat compat = WindowInsetsCompat.toWindowInsetsCompat(insets, view);
+        WindowInsetsCompat.Builder builder = new WindowInsetsCompat.Builder(compat);
+        for (int type = 1; type <= TYPES; type <<= 1) {
+            if ((TYPES & type) == 0) continue;
+            Insets i = compat.getInsets(type);
+            builder.setInsets(type, Insets.of(covering(i.left, left), covering(i.top, top),
+                    covering(i.right, right), covering(i.bottom, bottom)));
+        }
+        // The cutout's own safe area (read separately by some code): dropped when none of it covers the view.
+        Insets cut = compat.getInsets(WindowInsetsCompat.Type.displayCutout());
+        if (covering(cut.left, left) == 0 && covering(cut.top, top) == 0 && covering(cut.right, right) == 0
+                && covering(cut.bottom, bottom) == 0) {
+            builder.setDisplayCutout(null);
+        }
+        WindowInsets out = builder.build().toWindowInsets();
+        return out != null ? out : insets;
+    }
+
+    /** Applies the insets again when the view's place in the window changes; add on attach, remove on detach. */
+    static ViewTreeObserver.OnGlobalLayoutListener watcher(@NonNull View view) {
+        final Rect last = new Rect();
+        final int[] at = new int[2];
+        return () -> {
+            view.getLocationInWindow(at);
+            if (last.left == at[0] && last.top == at[1] && last.width() == view.getWidth() && last.height() == view.getHeight()) return;
+            last.set(at[0], at[1], at[0] + view.getWidth(), at[1] + view.getHeight());
+            view.requestApplyInsets();
+        };
+    }
+}
