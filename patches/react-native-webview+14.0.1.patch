+  for (WKContentRuleList *list in _attachedContentRuleLists) {
+    [controller removeContentRuleList:list];
+  }
+  for (WKContentRuleList *list in wanted) {
+    [controller addContentRuleList:list];
+  }
+  _attachedContentRuleLists = wanted;
+}
