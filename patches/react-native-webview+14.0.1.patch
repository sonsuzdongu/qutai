+RCT_EXPORT_METHOD(deleteCookie:(NSString *)store url:(NSString *)url line:(NSString *)line name:(NSString *)name domain:(NSString *)domain path:(NSString *)path resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject)
