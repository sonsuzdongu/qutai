+package com.reactnativecommunity.webview;
+
+import android.net.Uri;
+import android.net.http.SslCertificate;
+import android.net.http.SslError;
+import android.os.Build;
+import android.os.Bundle;
+
+import androidx.annotation.Nullable;
+
+import java.security.MessageDigest;
+import java.security.cert.X509Certificate;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Set;
+
+/**
+ * Qutai patch: certificate errors the user chose to continue past (the certificateExceptions prop).
+ *
+ * The app's error page offers "Continue anyway" for a certificate the WebView refused; when the user taps it, the app
+ * adds "host:port sha256" to this WebView's list and loads the page again. onReceivedSslError proceeds only when the
+ * failing request's host and port and the SHA-256 of the presented certificate are in that list, so the WebView never
+ * proceeds on its own: every proceed is a decision the user made for that exact certificate (Google Play's rule for
+ * onReceivedSslError). The list lives in the app's memory only.
+ */
+final class RNCWebViewCertificates {
+    private RNCWebViewCertificates() {}
+
+    /** "host:port sha256" lines as a set (lowercase, trimmed). */
+    static Set<String> parse(@Nullable String value) {
+        if (value == null || value.trim().isEmpty()) return Collections.emptySet();
+        Set<String> out = new HashSet<>();
+        for (String line : value.split("\n")) {
+            String s = line.trim().toLowerCase(Locale.ROOT);
+            if (!s.isEmpty()) out.add(s);
+        }
+        return Collections.unmodifiableSet(out);
+    }
+
+    /** "host:port" of an https URL (default port 443, IPv6 without brackets), as the app's certificateKey builds it. */
+    static @Nullable String key(@Nullable String url) {
+        if (url == null) return null;
+        Uri uri = Uri.parse(url);
+        String host = uri.getHost();
+        if (host == null || !"https".equalsIgnoreCase(uri.getScheme())) return null;
+        host = host.toLowerCase(Locale.ROOT);
+        if (host.startsWith("[") && host.endsWith("]")) host = host.substring(1, host.length() - 1);
+        if (host.endsWith(".")) host = host.substring(0, host.length() - 1);
+        int port = uri.getPort();
+        return host + ":" + (port > 0 ? port : 443);
+    }
+
+    /** SHA-256 of the certificate's DER encoding, lowercase hex; null if it can't be read. */
+    static @Nullable String fingerprint(SslError error) {
+        try {
+            SslCertificate certificate = error.getCertificate();
+            byte[] der = null;
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+                X509Certificate x509 = certificate.getX509Certificate();
+                if (x509 != null) der = x509.getEncoded();
+            } else {
+                // Before API 29 the DER bytes are only reachable through the saved state (AOSP's key).
+                Bundle state = SslCertificate.saveState(certificate);
+                if (state != null) der = state.getByteArray("x509-certificate");
+            }
+            if (der == null) return null;
+            byte[] digest = MessageDigest.getInstance("SHA-256").digest(der);
+            StringBuilder hex = new StringBuilder(digest.length * 2);
+            for (byte b : digest) hex.append(String.format(Locale.ROOT, "%02x", b));
+            return hex.toString();
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /** Whether the user allowed this certificate on the failing request's host. */
+    static boolean allowed(Set<String> exceptions, SslError error, @Nullable String fingerprint) {
+        if (exceptions.isEmpty() || fingerprint == null) return false;
+        String key = key(error.getUrl());
+        return key != null && exceptions.contains(key + " " + fingerprint);
+    }
+}
