+  dispatch_async(dispatch_get_main_queue(), ^{
+    WKWebsiteDataStore *dataStore = RNCCookieStore(store);
+    if (dataStore == nil) {
+      reject(@"E_COOKIE_STORE", @"This tab's cookie store is not available", nil);
+      return;
+    }
+    WKHTTPCookieStore *cookieStore = dataStore.httpCookieStore;
+    [cookieStore getAllCookies:^(NSArray<NSHTTPCookie *> *cookies) {
+      NSString *wantDomain = [domain.lowercaseString hasPrefix:@"."] ? [domain.lowercaseString substringFromIndex:1] : domain.lowercaseString;
+      NSMutableArray<NSHTTPCookie *> *matches = [NSMutableArray new];
+      for (NSHTTPCookie *cookie in cookies) {
+        NSString *d = cookie.domain.lowercaseString;
+        NSString *bare = [d hasPrefix:@"."] ? [d substringFromIndex:1] : d;
