+package com.reactnativecommunity.webview;
+
+import android.webkit.ValueCallback;
+import android.webkit.WebView;
+
+import androidx.annotation.Nullable;
+
+import org.json.JSONObject;
+
+/**
+ * Qutai patch: media playing in pages, for the app's background playback service and picture-in-picture
+ * (modules/qutai-media in the app).
+ *
+ * The app's page script posts its media state as {"__qutaiPlayback":"<key>",...}. React Native stops delivering
+ * events and view commands while the activity is paused, so these messages are also handed to a native listener
+ * here, on the main thread, and the listener can run playback commands in the page directly. Only messages that
+ * carry the view's key (set by the app through the mediaPlayback prop, known only to its own page script) reach it.
+ */
+public final class RNCWebViewPlayback {
+    private RNCWebViewPlayback() {}
+
+    public interface Listener {
+        /** A page reported its media state (the script's JSON). Main thread. */
+        void onPlaybackState(WebView view, boolean isPrivate, String json);
+
+        /** The page showed or left a full-screen video (WebChromeClient custom view). Main thread. */
+        void onFullscreenChanged(WebView view, boolean fullscreen);
+
+        /** The WebView was destroyed (its tab closed or put to sleep). Main thread. */
+        void onWebViewGone(WebView view);
+    }
+
+    private static volatile @Nullable Listener listener;
+
+    public static void setListener(@Nullable Listener value) {
+        listener = value;
+    }
+
+    /** From the mediaPlayback prop: "<key>" or "<key> private"; empty or null turns it off. */
+    static void configure(RNCWebView view, @Nullable String value) {
+        if (value == null || value.trim().isEmpty()) {
+            view.mediaPlaybackKey = null;
+            view.mediaPlaybackPrivate = false;
+            return;
+        }
+        String[] parts = value.trim().split("\\s+");
+        view.mediaPlaybackKey = parts[0];
+        view.mediaPlaybackPrivate = parts.length > 1 && "private".equals(parts[1]);
+    }
+
+    /** Called for every message the page posts (main thread); forwards the view's own playback messages. */
+    static void report(RNCWebView view, String message) {
+        String key = view.mediaPlaybackKey;
+        Listener current = listener;
+        if (key == null || current == null || message == null) return;
+        if (!message.startsWith("{\"__qutaiPlayback\":" + JSONObject.quote(key) + ",")) return;
+        current.onPlaybackState(view, view.mediaPlaybackPrivate, message);
+    }
+
+    /** The view to show for a page's full-screen video (keeps background playback's visibility, see RNCWebView). */
+    static android.view.View fullscreenView(RNCWebView view, android.view.View content) {
+        RNCWebView.FullscreenFrame frame = new RNCWebView.FullscreenFrame(view, content);
+        view.fullscreenFrame = frame;
+        return frame;
+    }
+
+    static void fullscreen(RNCWebView view, boolean on) {
+        if (!on) view.fullscreenFrame = null;
+        Listener current = listener;
+        if (current != null) current.onFullscreenChanged(view, on);
+    }
+
+    static void gone(RNCWebView view) {
+        Listener current = listener;
+        if (current != null) current.onWebViewGone(view);
+    }
+
+    /** Whether the view belongs to an incognito tab ("private"); true for views the app didn't configure. */
+    public static boolean isPrivate(WebView view) {
+        if (!(view instanceof RNCWebView)) return true;
+        RNCWebView web = (RNCWebView) view;
+        return web.mediaPlaybackKey == null || web.mediaPlaybackPrivate;
+    }
+
+    /**
+     * Keeps the page seeing itself as visible while the app is in the background (true), or lets it see the real
+     * state (false, the default). For the tab that owns background playback only; see RNCWebView. Main thread.
+     */
+    public static void setKeepVisible(WebView view, boolean keep) {
+        if (view instanceof RNCWebView) ((RNCWebView) view).setPlaybackKeepVisible(keep);
+    }
+
+    /**
+     * Runs a playback command in the page's script: play, pause, stop, nexttrack, previoustrack, seekto (seconds),
+     * seekforward, seekbackward. Main thread.
+     */
+    public static void command(WebView view, String action, double seconds) {
+        command(view, action, seconds, null);
+    }
+
+    /** As above; done (if any) runs on the main thread once the page's script has run the command. */
+    public static void command(WebView view, String action, double seconds, @Nullable ValueCallback<String> done) {
+        if (!(view instanceof RNCWebView)) return;
+        String key = ((RNCWebView) view).mediaPlaybackKey;
+        if (key == null) return;
+        String arg = Double.isNaN(seconds) || Double.isInfinite(seconds) ? "null" : Double.toString(seconds);
+        view.evaluateJavascript(
+            "window.__qutaiPlayback && window.__qutaiPlayback(" + JSONObject.quote(key) + ", " + JSONObject.quote(action)
+                + ", " + arg + "); void 0;",
+            done);
+    }
+}
