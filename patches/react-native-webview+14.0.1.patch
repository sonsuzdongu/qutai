+#pragma mark - Qutai patch: content blocking
+
+- (void)setContentBlocking:(BOOL)contentBlocking
+{
+  _contentBlocking = contentBlocking;
+  [self applyContentRuleListsForURL:_webView.URL];
+}
+
+- (void)setContentBlockingOffSites:(NSString *)contentBlockingOffSites
+{
+  _contentBlockingOffSites = [contentBlockingOffSites copy];
+  _contentOffSiteSet = [NSSet setWithArray:RNCLines(contentBlockingOffSites)];
+  [self applyContentRuleListsForURL:_webView.URL];
+}
+
+- (void)setContentRuleLists:(NSString *)contentRuleLists
+{
+  _contentRuleLists = [contentRuleLists copy];
+  NSArray<NSString *> *ids = RNCLines(contentRuleLists);
+  _contentRuleListIds = ids;
+  NSMutableDictionary<NSString *, WKContentRuleList *> *cache = RNCContentRuleListCache();
+  for (NSString *identifier in ids) {
+    if (cache[identifier] != nil) continue;
+    __weak RNCWebViewImpl *weakSelf = self;
+    [[WKContentRuleListStore defaultStore] lookUpContentRuleListForIdentifier:identifier completionHandler:^(WKContentRuleList *list, NSError *error) {
+      dispatch_async(dispatch_get_main_queue(), ^{
+        if (list == nil) return;
+        RNCContentRuleListCache()[identifier] = list;
+        RNCWebViewImpl *strongSelf = weakSelf;
+        if (strongSelf != nil) [strongSelf applyContentRuleListsForURL:strongSelf->_webView.URL];
+      });
+    }];
+  }
+  [self applyContentRuleListsForURL:_webView.URL];
+}
+
+/** Whether host is one of the off sites or a subdomain of one. */
+- (BOOL)isContentBlockingOffForHost:(NSString *)host
+{
+  if (host.length == 0 || _contentOffSiteSet.count == 0) return NO;
+  NSString *h = host.lowercaseString;
+  for (NSString *site in _contentOffSiteSet) {
+    if ([h isEqualToString:site] || [h hasSuffix:[@"." stringByAppendingString:site]]) return YES;
+  }
+  return NO;
+}
+
+/**
+ * Attaches the compiled lists to this WebView's user content controller, or none when blocking is off or the
+ * top-level page (url, or the current one when nil) is on an off site. Takes effect for the following loads.
+ */
+- (void)applyContentRuleListsForURL:(NSURL *)url
+{
+  if (_webView == nil) return;
+  NSURL *page = url ?: _webView.URL;
+  NSMutableArray<WKContentRuleList *> *wanted = [NSMutableArray new];
+  if (_contentBlocking && ![self isContentBlockingOffForHost:page.host]) {
+    NSMutableDictionary<NSString *, WKContentRuleList *> *cache = RNCContentRuleListCache();
+    for (NSString *identifier in _contentRuleListIds) {
+      WKContentRuleList *list = cache[identifier];
+      if (list != nil) [wanted addObject:list];
+    }
+  }
+  if (_attachedContentRuleLists != nil && [wanted isEqualToArray:_attachedContentRuleLists]) return;
+  WKUserContentController *controller = _webView.configuration.userContentController;
+  for (WKContentRuleList *list in _attachedContentRuleLists) {
+    [controller removeContentRuleList:list];
+  }
+  for (WKContentRuleList *list in wanted) {
+    [controller addContentRuleList:list];
+  }
+  _attachedContentRuleLists = wanted;
+}
