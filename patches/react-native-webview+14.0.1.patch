+/**
+ * Qutai patch: network ad and tracker blocking by domain (the contentBlocking prop).
+ *
+ * The app writes one file of domains compiled from the user's filter lists (src/content/filterLists.ts ›
+ * androidBlockerFile): a header line, then "b domain" (blocked), "t domain" (blocked when third-party) and
+ * "e domain" (exception) lines. It is read on a background thread into immutable hash sets that replace the
+ * previous ones in one volatile write, so WebView's request threads always see a complete set. A file that fails
+ * to load leaves the previous sets in use.
+ *
+ * A lookup walks the request host's parent domains ("a.b.example.com", "b.example.com", "example.com"), one hash
+ * lookup each: O(labels). An exception anywhere in that chain wins.
+ */
+public final class RNCWebViewContentBlocker {
+    private static final String TAG = "RNCWebViewContentBlocker";
+    private static final String HEADER = "qutai-content-blocker 1";
+    /** A broken or hostile file must not exhaust memory. */
+    private static final int MAX_ENTRIES = 500_000;
+    private static final int MAX_LINE = 300;
+
+    private static final class Sets {
+        final Set<String> block;
+        final Set<String> thirdParty;
+        final Set<String> allow;
+
+        Sets(Set<String> block, Set<String> thirdParty, Set<String> allow) {
+            this.block = block;
+            this.thirdParty = thirdParty;
+            this.allow = allow;
+        }
+    }
+
+    private static volatile @Nullable Sets sSets = null;
+    private static final ExecutorService sLoader = Executors.newSingleThreadExecutor();
+
+    private RNCWebViewContentBlocker() {}
+
+    /** Loads the domain file off the UI thread ("" clears it); resolves with the number of entries. */
+    public static void load(final String path, final Promise promise) {
+        sLoader.execute(() -> {
+            if (path == null || path.isEmpty()) {
+                sSets = null;
+                promise.resolve(0);
+                return;
+            }
+            Set<String> block = new HashSet<>();
+            Set<String> thirdParty = new HashSet<>();
+            Set<String> allow = new HashSet<>();
+            int count = 0;
+            try (BufferedReader reader = new BufferedReader(
+                    new InputStreamReader(new FileInputStream(path), StandardCharsets.UTF_8))) {
+                String line = reader.readLine();
+                if (line == null || !line.trim().equals(HEADER)) {
+                    promise.reject("E_CONTENT_BLOCKER", "Not a content blocker file");
+                    return;
+                }
+                while ((line = reader.readLine()) != null && count < MAX_ENTRIES) {
+                    if (line.length() < 3 || line.length() > MAX_LINE || line.charAt(1) != ' ') continue;
+                    String domain = line.substring(2).trim().toLowerCase(Locale.ROOT);
+                    if (domain.isEmpty() || domain.indexOf('.') < 0) continue;
+                    switch (line.charAt(0)) {
+                        case 'b': block.add(domain); break;
+                        case 't': thirdParty.add(domain); break;
+                        case 'e': allow.add(domain); break;
+                        default: continue;
+                    }
+                    count++;
+                }
+            } catch (Exception | OutOfMemoryError e) {
+                Log.e(TAG, "Could not load the content blocker; the previous one stays", e);
+                promise.reject("E_CONTENT_BLOCKER", e.getMessage());
+                return;
+            }
+            sSets = new Sets(
+                    Collections.unmodifiableSet(block),
+                    Collections.unmodifiableSet(thirdParty),
+                    Collections.unmodifiableSet(allow));
+            promise.resolve(count);
+        });
+    }
+
+    /** "example.com\nother.org" (the contentBlockingOffSites prop) as a set. */
+    public static Set<String> parseSites(@Nullable String value) {
+        if (value == null || value.trim().isEmpty()) return Collections.emptySet();
+        Set<String> sites = new HashSet<>();
+        for (String site : value.split("\n")) {
+            String s = site.trim().toLowerCase(Locale.ROOT);
+            // The app keys sites with a non-default port ("example.com:8443"); pages are matched by host.
+            if (!s.startsWith("[")) s = s.replaceFirst(":\\d+$", "");
+            if (!s.isEmpty()) sites.add(s);
+        }
+        return Collections.unmodifiableSet(sites);
+    }
+
+    /**
+     * Whether a request to host, from a page whose top-level host is pageHost, is blocked. Called on WebView's
+     * request threads. Never blocks anything on a page of an "off" site (or one of its subdomains).
+     */
+    static boolean shouldBlock(String rawHost, @Nullable String pageHost, Set<String> offSites) {
+        Sets sets = sSets;
+        if (sets == null) return false;
+        String host = normalize(rawHost);
+        if (host.isEmpty() || isLocal(host)) return false;
+        String page = pageHost != null ? normalize(pageHost) : null;
+        if (page != null && !offSites.isEmpty()) {
+            for (String d = page; d != null; d = parent(d, true)) {
+                if (offSites.contains(d)) return false;
+            }
+        }
+        boolean blocked = false;
+        boolean thirdPartyOnly = false;
+        for (String d = host; d != null; d = parent(d, false)) {
+            if (sets.allow.contains(d)) return false;
+            if (sets.block.contains(d)) blocked = true;
+            else if (sets.thirdParty.contains(d)) thirdPartyOnly = true;
+        }
+        if (blocked) return true;
+        return thirdPartyOnly && (page == null || page.isEmpty() || !registrableDomain(host).equals(registrableDomain(page)));
+    }
+
+    /** A new empty 403 response for a blocked request (its stream is read once). */
+    static WebResourceResponse blockedResponse() {
+        Map<String, String> headers = new HashMap<>();
+        headers.put("Cache-Control", "no-store");
+        return new WebResourceResponse("text/plain", "utf-8", 403, "Blocked", headers, new ByteArrayInputStream(new byte[0]));
+    }
+
+    private static String normalize(String host) {
+        String h = host.toLowerCase(Locale.ROOT);
+        if (h.endsWith(".")) h = h.substring(0, h.length() - 1);
+        // IPv6 literals: never in the sets.
+        if (h.startsWith("[")) return "";
+        return h;
+    }
+
+    /**
+     * Hosts on the device or the local network (localhost, .local and .home.arpa names, loopback, private and
+     * link-local IPv4): never ad or tracker servers, and a local app's own resources must always load. IPv6 literals
+     * are already skipped by normalize.
+     */
+    static boolean isLocal(String host) {
+        if (host.equals("localhost") || host.endsWith(".localhost") || host.endsWith(".local")
+                || host.endsWith(".home.arpa")) return true;
+        if (!host.matches("\\d{1,3}(\\.\\d{1,3}){3}")) return false;
+        String[] p = host.split("\\.");
+        int a = Integer.parseInt(p[0]);
+        int b = Integer.parseInt(p[1]);
+        return a == 127 || a == 10 || (a == 172 && b >= 16 && b <= 31) || (a == 192 && b == 168) || (a == 169 && b == 254);
+    }
+
+    /** "a.b.example.com" -> "b.example.com"; null once only the top-level domain is left (or, if allowTld, none). */
+    private static @Nullable String parent(String domain, boolean allowTld) {
+        int dot = domain.indexOf('.');
+        if (dot < 0) return null;
+        String rest = domain.substring(dot + 1);
+        if (!allowTld && rest.indexOf('.') < 0) return null;
+        return rest;
+    }
+
+    /** Same heuristic as filterLists.ts › SECOND_LEVEL_SUFFIXES (keep in sync). */
+    private static final Set<String> SECOND_LEVEL = new HashSet<>(Arrays.asList(
+            "ac", "co", "com", "edu", "gen", "go", "gob", "gouv", "gov", "k12", "ltd", "mil", "ne", "net", "nic", "nom",
+            "or", "org", "plc", "sch"));
+    private static final Set<String> TR_SECOND_LEVEL = new HashSet<>(Arrays.asList(
+            "av", "bbs", "bel", "biz", "dr", "info", "kep", "name", "pol", "tel", "tsk", "tv", "web"));
+
+    /**
+     * The site a host belongs to, for third-party rules: the last two labels, or three under a two-letter country
+     * code whose second level looks public ("bbc.co.uk", "hurriyet.com.tr"). No full Public Suffix List: hosting
+     * suffixes such as github.io count as one site (fewer blocks there, never more). IPv4 addresses are their own site.
+     */
+    static String registrableDomain(String host) {
+        String[] labels = host.split("\\.");
+        int n = labels.length;
+        if (n <= 2) return host;
+        if (labels[n - 1].matches("\\d+")) return host;
+        String tld = labels[n - 1];
+        String second = labels[n - 2];
+        boolean country = tld.length() == 2
+                && (SECOND_LEVEL.contains(second) || (tld.equals("tr") && TR_SECOND_LEVEL.contains(second)));
+        int keep = country ? 3 : 2;
+        StringBuilder out = new StringBuilder();
+        for (int i = n - keep; i < n; i++) {
+            if (out.length() > 0) out.append('.');
+            out.append(labels[i]);
+        }
+        return out.toString();
+    }
+}
