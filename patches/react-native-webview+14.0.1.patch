+// Qutai patch: network ad and tracker blocking with WebKit content rule lists (the domain file is Android's).
+RCT_EXPORT_METHOD(loadContentBlocker:(NSString *)path resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject)
+{
+    resolve(@0);
+}
+
+/*
+ * WKContentRuleListStore is main-thread only (WK_SWIFT_UI_ACTOR); the methods below run on the TurboModule queue
+ * (this module has no methodQueue), so every store call is sent to the main queue. Touching the store first from
+ * that queue initialises WebKit off the main thread, which crashed at launch before the first WKWebView existed.
+ * The store calls its completion handlers once, on the main thread, so each promise settles exactly once.
+ */
+
+/** Compiles a list from a JSON file (read here, off the main thread; WebKit compiles on its own queue). */
+RCT_EXPORT_METHOD(compileContentRuleList:(NSString *)identifier path:(NSString *)path resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject)
+{
+    NSError *readError = nil;
+    NSString *json = [NSString stringWithContentsOfFile:path encoding:NSUTF8StringEncoding error:&readError];
+    if (json == nil) {
+        reject(@"E_CONTENT_RULES", readError.localizedDescription ?: @"Unreadable rule list", readError);
+        return;
+    }
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [[WKContentRuleListStore defaultStore] compileContentRuleListForIdentifier:identifier
+                                                            encodedContentRuleList:json
+                                                                 completionHandler:^(WKContentRuleList *list, NSError *error) {
+            if (list == nil) {
+                reject(@"E_CONTENT_RULES", error.localizedDescription ?: @"Could not compile the rule list", error);
+            } else {
+                resolve(nil);
+            }
+        }];
+    });
+}
+
+RCT_EXPORT_METHOD(hasContentRuleList:(NSString *)identifier resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject)
+{
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [[WKContentRuleListStore defaultStore] lookUpContentRuleListForIdentifier:identifier completionHandler:^(WKContentRuleList *list, NSError *error) {
+            resolve(@(list != nil));
+        }];
+    });
+}
+
+/** Removes the compiled lists whose identifier starts with prefix, except those in keep (one per line). */
+RCT_EXPORT_METHOD(removeContentRuleLists:(NSString *)prefix keep:(NSString *)keep resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject)
+{
+    NSSet<NSString *> *kept = [NSSet setWithArray:[keep componentsSeparatedByString:@"\n"]];
+    dispatch_async(dispatch_get_main_queue(), ^{
+        WKContentRuleListStore *store = [WKContentRuleListStore defaultStore];
+        [store getAvailableContentRuleListIdentifiers:^(NSArray<NSString *> *identifiers) {
+            dispatch_group_t group = dispatch_group_create();
+            for (NSString *identifier in identifiers) {
+                if (prefix.length == 0 || ![identifier hasPrefix:prefix] || [kept containsObject:identifier]) continue;
+                dispatch_group_enter(group);
+                [store removeContentRuleListForIdentifier:identifier completionHandler:^(NSError *error) {
+                    dispatch_group_leave(group);
+                }];
+            }
+            dispatch_group_notify(group, dispatch_get_main_queue(), ^{
+                resolve(nil);
+            });
+        }];
+    });
+}
