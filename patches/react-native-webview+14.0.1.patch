+ */
+static BOOL RNCMediaCaptureGranted(NSString *grant, WKSecurityOrigin *origin, WKFrameInfo *frame, WKMediaCaptureType type) API_AVAILABLE(ios(15.0), macos(12.0)) {
+  if (!frame.isMainFrame) return NO;
+  NSArray<NSString *> *parts = [grant componentsSeparatedByString:@" "];
+  if (parts.count < 2) return NO;
+  NSString *requester = origin.port > 0
+    ? [NSString stringWithFormat:@"%@://%@:%ld", origin.protocol, origin.host, (long)origin.port]
+    : [NSString stringWithFormat:@"%@://%@", origin.protocol, origin.host];
+  if (![requester isEqualToString:parts[0]]) return NO;
+  BOOL camera = [parts containsObject:@"camera"];
+  BOOL microphone = [parts containsObject:@"microphone"];
+  switch (type) {
+    case WKMediaCaptureTypeCamera: return camera;
+    case WKMediaCaptureTypeMicrophone: return microphone;
+    case WKMediaCaptureTypeCameraAndMicrophone: return camera && microphone;
+    default: return NO;
+  }
+}
