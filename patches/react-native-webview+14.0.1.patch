@@ -0,0 +1,74 @@
+package com.reactnativecommunity.webview;
+
+import android.webkit.HttpAuthHandler;
+
+import androidx.annotation.Nullable;
+import androidx.annotation.UiThread;
+
+import java.lang.ref.WeakReference;
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.Map;
+
+/**
+ * Qutai patch: a site's request for a user name and password (HTTP Basic or Digest, a 401 with WWW-Authenticate)
+ * answered by the app's own dialog. The WebView waits on the HttpAuthHandler; it is kept here under an id that the
+ * app's onHttpAuthRequest event carries, and the app answers through RNCWebViewModule (answerHttpAuth /
+ * cancelHttpAuth), never through a view prop, so the password is never part of the view's props. Nothing is
+ * stored: the WebView's own credential store is not used (proceed is called each time). A request whose WebView
+ * goes away is cancelled.
+ *
+ * All methods run on the UI thread.
+ */
+public final class RNCWebViewHttpAuth {
+    private static final class Pending {
+        final HttpAuthHandler handler;
+        final WeakReference<RNCWebView> view;
+
+        Pending(HttpAuthHandler handler, RNCWebView view) {
+            this.handler = handler;
+            this.view = new WeakReference<>(view);
+        }
+    }
+
+    private static final Map<String, Pending> sPending = new HashMap<>();
+    private static int sCounter = 0;
+
+    private RNCWebViewHttpAuth() {}
+
+    @UiThread
+    public static String hold(HttpAuthHandler handler, RNCWebView view) {
+        String id = "h" + (++sCounter);
+        sPending.put(id, new Pending(handler, view));
+        return id;
+    }
+
+    @UiThread
+    public static void answer(String id, String username, String password) {
+        Pending p = sPending.remove(id);
+        if (p == null) return;
+        p.handler.proceed(username, password);
+    }
+
+    /** The user cancelled: the WebView shows the site's own 401 page. */
+    @UiThread
+    public static void cancel(@Nullable String id) {
+        if (id == null) return;
+        Pending p = sPending.remove(id);
+        if (p != null) p.handler.cancel();
+    }
+
+    /** The WebView is going away: its open requests are cancelled. */
+    @UiThread
+    public static void cancelAll(RNCWebView view) {
+        Iterator<Map.Entry<String, Pending>> it = sPending.entrySet().iterator();
+        while (it.hasNext()) {
+            Pending p = it.next().getValue();
+            RNCWebView v = p.view.get();
+            if (v == null || v == view) {
+                it.remove();
+                p.handler.cancel();
+            }
+        }
+    }
+}
