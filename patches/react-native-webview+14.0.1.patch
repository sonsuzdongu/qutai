@@ -0,0 +1,104 @@
+package com.reactnativecommunity.webview;
+
+import android.view.MotionEvent;
+import android.view.ViewParent;
+
+import androidx.annotation.Nullable;
+import androidx.swiperefreshlayout.widget.SwipeRefreshLayout;
+
+import org.json.JSONObject;
+
+/**
+ * Qutai patch: pull to refresh decided per touch (the app's src/browser/pullToRefresh.ts).
+ *
+ * The app wraps the WebView in a SwipeRefreshLayout. That layout only knows whether its own child can scroll, not
+ * whether the page or a scroll area inside it can, and React Native state arrives too late to switch it per touch.
+ * So the page's script answers each touchstart with {"__qutaiPull":true,"touch":true,"atTop":...}, which reaches
+ * this class on the UI thread through the message bridge, and the WebView turns the layout off for that touch
+ * unless the answer is "refresh is fine". The layout records the touch's start before the WebView sees it (its
+ * intercept runs first), so turning it off and on again within the touch keeps its distance right.
+ *
+ * Main thread only.
+ */
+final class RNCWebViewPull {
+    static final String PREFIX = "{\"__qutaiPull\":true";
+
+    private final RNCWebView view;
+    /** This page's script reports touches; until it does (a page still loading), only the page's own scroll counts. */
+    private boolean pageAnswers = false;
+    /** A finger is down. */
+    private boolean touching = false;
+    /** The layout this class turned off for the current touch, to turn on again when it ends. */
+    private @Nullable SwipeRefreshLayout turnedOff = null;
+
+    RNCWebViewPull(RNCWebView view) {
+        this.view = view;
+    }
+
+    /** A new page: its script hasn't answered yet. */
+    void pageStarted() {
+        pageAnswers = false;
+    }
+
+    /** Called with every touch event before the WebView handles it. */
+    void onTouch(MotionEvent event) {
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                touching = true;
+                // Off until the page answers for this touch.
+                if (pageAnswers) block(true);
+                break;
+            case MotionEvent.ACTION_MOVE:
+                // The page itself scrolled down during the drag.
+                if (view.canScrollVertically(-1)) block(true);
+                break;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL:
+                touching = false;
+                block(false);
+                break;
+            default:
+                break;
+        }
+    }
+
+    /** True when the message was a pull report (handled here, never passed to the app). */
+    boolean handleMessage(String message, boolean isMainFrame) {
+        if (message == null || !message.startsWith(PREFIX)) return false;
+        if (!isMainFrame) return true;
+        try {
+            JSONObject json = new JSONObject(message);
+            pageAnswers = true;
+            if (!touching) return true;
+            if (json.optBoolean("took")) {
+                block(true);
+            } else if (json.optBoolean("touch")) {
+                block(!json.optBoolean("atTop") || view.canScrollVertically(-1));
+            }
+        } catch (Exception ignored) {
+            // Not a well-formed report: nothing changes.
+        }
+        return true;
+    }
+
+    private void block(boolean off) {
+        if (off) {
+            if (turnedOff != null) return;
+            SwipeRefreshLayout layout = findLayout();
+            // Turning a refreshing layout off would hide its spinner; it ignores drags while refreshing anyway.
+            if (layout == null || !layout.isEnabled() || layout.isRefreshing()) return;
+            layout.setEnabled(false);
+            turnedOff = layout;
+        } else if (turnedOff != null) {
+            turnedOff.setEnabled(true);
+            turnedOff = null;
+        }
+    }
+
+    private @Nullable SwipeRefreshLayout findLayout() {
+        for (ViewParent p = view.getParent(); p != null; p = p.getParent()) {
+            if (p instanceof SwipeRefreshLayout) return (SwipeRefreshLayout) p;
+        }
+        return null;
+    }
+}
