+package com.reactnativecommunity.webview;
+
+import android.webkit.CookieManager;
+
+import androidx.annotation.Nullable;
+import androidx.webkit.CookieManagerCompat;
+import androidx.webkit.WebViewFeature;
+
+import com.facebook.react.bridge.Promise;
+import com.facebook.react.bridge.UiThreadUtil;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.util.List;
+
+/**
+ * Qutai patch: the cookie list (docs/page-customisation.md › Cookies). Reads the cookies of a tab's store (the
+ * default one, or an incognito profile's, see RNCWebViewProfiles) for some addresses, HttpOnly ones included, and
+ * deletes one by writing an expired cookie with the same key. Values go to the app's Cookies view only; nothing here
+ * logs them.
+ */
+class RNCWebViewCookies {
+    private static @Nullable CookieManager managerFor(String store) {
+        if (store == null || store.isEmpty()) return CookieManager.getInstance();
+        return RNCWebViewProfiles.cookieManagerForProfile(store);
+    }
+
+    /** urls: a JSON array of addresses. Resolves with {"detailed": bool, "entries": [{"url", "cookies": [...]}]}. */
+    static void get(final String urls, final String store, final Promise promise) {
+        UiThreadUtil.runOnUiThread(() -> {
+            try {
+                CookieManager manager = managerFor(store);
+                if (manager == null) {
+                    promise.reject("E_COOKIE_STORE", "This tab's cookie store is not available");
+                    return;
+                }
+                boolean detailed = WebViewFeature.isFeatureSupported(WebViewFeature.GET_COOKIE_INFO);
+                JSONArray list = new JSONArray(urls);
+                JSONArray entries = new JSONArray();
+                for (int i = 0; i < list.length() && i < 40; i++) {
+                    String url = list.getString(i);
+                    JSONArray cookies = new JSONArray();
+                    if (detailed) {
+                        List<String> info = CookieManagerCompat.getCookieInfo(manager, url);
+                        for (String line : info) cookies.put(line);
+                    } else {
+                        String header = manager.getCookie(url);
+                        if (header != null && !header.isEmpty()) cookies.put(header);
+                    }
+                    JSONObject entry = new JSONObject();
+                    entry.put("url", url);
+                    entry.put("cookies", cookies);
+                    entries.put(entry);
+                }
+                JSONObject result = new JSONObject();
+                result.put("detailed", detailed);
+                result.put("entries", entries);
+                promise.resolve(result.toString());
+            } catch (Exception e) {
+                promise.reject("E_COOKIE_STORE", "The cookie store could not be read", e);
+            }
+        });
+    }
+
+    /** line: an expired Set-Cookie line with the cookie's name, path, domain and Secure flag, for url. */
+    static void delete(final String store, final String url, final String line, final Promise promise) {
+        UiThreadUtil.runOnUiThread(() -> {
+            try {
+                CookieManager manager = managerFor(store);
+                if (manager == null) {
+                    promise.reject("E_COOKIE_STORE", "This tab's cookie store is not available");
+                    return;
+                }
+                manager.setCookie(url, line, (ok) -> {
+                    manager.flush();
+                    promise.resolve(Boolean.TRUE.equals(ok));
+                });
+            } catch (Exception e) {
+                promise.reject("E_COOKIE_STORE", "The cookie could not be deleted", e);
+            }
+        });
