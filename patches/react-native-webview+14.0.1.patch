+/** Compiles a list from a JSON file (read here, off the main thread; WebKit compiles on its own queue). */
+RCT_EXPORT_METHOD(compileContentRuleList:(NSString *)identifier path:(NSString *)path resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject)
+{
+    NSError *readError = nil;
+    NSString *json = [NSString stringWithContentsOfFile:path encoding:NSUTF8StringEncoding error:&readError];
+    if (json == nil) {
+        reject(@"E_CONTENT_RULES", readError.localizedDescription ?: @"Unreadable rule list", readError);
+        return;
+    }
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [[WKContentRuleListStore defaultStore] compileContentRuleListForIdentifier:identifier
+                                                            encodedContentRuleList:json
+                                                                 completionHandler:^(WKContentRuleList *list, NSError *error) {
+            if (list == nil) {
+                reject(@"E_CONTENT_RULES", error.localizedDescription ?: @"Could not compile the rule list", error);
+            } else {
+                resolve(nil);
+            }
+        }];
+    });
+}
