+#import "ExpoSpeechCatchException.h"
+
+NSException *_Nullable ExpoSpeechCatchException(NS_NOESCAPE void (^block)(void)) {
+  @try {
+    block();
+  } @catch (NSException *exception) {
+    return exception;
+  }
+  return nil;
+}
