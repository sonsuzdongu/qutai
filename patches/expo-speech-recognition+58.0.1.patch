diff --git a/node_modules/expo-speech-recognition/ios/ExpoSpeechCatchException.h b/node_modules/expo-speech-recognition/ios/ExpoSpeechCatchException.h
new file mode 100644
index 0000000..4a7c97c
--- /dev/null
+++ b/node_modules/expo-speech-recognition/ios/ExpoSpeechCatchException.h
@@ -0,0 +1,10 @@
+// Qutai patch (patches/expo-speech-recognition+58.0.1.patch, VOICE-26): AVAudioEngine reports a format it can't use
+// by raising an Objective-C exception, which Swift can't catch and which ended the app. This runs a block and hands
+// back the exception instead, so the recogniser reports an error.
+#import <Foundation/Foundation.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+FOUNDATION_EXPORT NSException *_Nullable ExpoSpeechCatchException(NS_NOESCAPE void (^block)(void));
+
+NS_ASSUME_NONNULL_END
diff --git a/node_modules/expo-speech-recognition/ios/ExpoSpeechCatchException.m b/node_modules/expo-speech-recognition/ios/ExpoSpeechCatchException.m
new file mode 100644
index 0000000..89bdb6b
--- /dev/null
+++ b/node_modules/expo-speech-recognition/ios/ExpoSpeechCatchException.m
@@ -0,0 +1,10 @@
+#import "ExpoSpeechCatchException.h"
+
+NSException *_Nullable ExpoSpeechCatchException(NS_NOESCAPE void (^block)(void)) {
+  @try {
+    block();
+  } @catch (NSException *exception) {
+    return exception;
+  }
+  return nil;
+}
